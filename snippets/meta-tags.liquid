{%- liquid
  # Preferir el SEO final definido en theme.liquid (SEO Package + fallbacks)
  assign social_title = seo_title | default: page_title | default: shop.name
  assign social_description = seo_description | default: page_description | default: shop.description | default: shop.name

  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ social_title | strip | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ social_description | strip_html | strip_newlines | strip | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | strip_html | strip | escape }}">

  <meta name="twitter:image" content="{{ page_image | image_url }}">
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- liquid
  assign twitter_url = settings.social_twitter_link | strip | remove: 'https://' | remove: 'http://'
  assign twitter_url = twitter_url | split: '?' | first | split: '#' | first
  assign twitter_parts = twitter_url | split: '/'
  assign twitter_domain = twitter_parts.first | downcase | remove: 'www.'
  assign twitter_handle = twitter_parts[1]
  assign valid_twitter = false
  if twitter_domain == 'x.com' or twitter_domain == 'twitter.com'
    if twitter_parts.size == 2 and twitter_handle.size > 0 and twitter_handle.size <= 15
      assign invalid_chars = twitter_handle | downcase | remove: '_'
      assign allowed_chars = 'abcdefghijklmnopqrstuvwxyz0123456789' | split: ''
      for char in allowed_chars
        assign invalid_chars = invalid_chars | remove: char
      endfor
      if invalid_chars == blank
        assign valid_twitter = true
      endif
      assign reserved_paths = 'home,intent,share,search,explore,settings,messages,compose,i' | split: ','
      assign normalized_handle = twitter_handle | downcase
      if reserved_paths contains normalized_handle
        assign valid_twitter = false
      endif
    endif
  endif
-%}
{%- if valid_twitter -%}
  <meta name="twitter:site" content="@{{ twitter_handle | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ social_title | strip | escape }}">
<meta name="twitter:description" content="{{ social_description | strip_html | strip_newlines | strip | escape }}">
